<% layout('layouts/boilerplate') %>

    <div class="container py-5" style="max-width: 900px;">

        <!-- Hero -->
        <div class="text-center mb-5">

            <i class="bi bi-shield-lock-fill text-primary" style="font-size:4rem;"></i>

            <h1 class="display-5 fw-bold mt-3">
                Privacy Policy
            </h1>

            <p class="lead text-muted">
                We value your privacy. This Privacy Policy explains how BooksSeeker
                collects, uses, and protects your personal information.
            </p>

            <span class="badge bg-light text-dark border">
                Last Updated: July 2026
            </span>

        </div>

        <hr>

        <!-- Introduction -->

        <section class="my-5">

            <h3 class="fw-bold">
                <i class="bi bi-info-circle-fill text-primary me-2"></i>
                Introduction
            </h3>

            <p class="text-muted mt-3">
                Welcome to <strong>BooksSeeker</strong>. We are committed to protecting
                your personal information and respecting your privacy.
                This Privacy Policy explains what information we collect,
                how we use it, and the choices you have regarding your data.
            </p>

        </section>

        <hr>

        <!-- Information -->

        <section class="my-5">

            <h3 class="fw-bold">
                <i class="bi bi-person-lines-fill text-success me-2"></i>
                Information We Collect
            </h3>

            <p class="text-muted mt-3">
                When you use BooksSeeker, we may collect the following information:
            </p>

            <ul class="text-muted">
                <li>Your username and account details.</li>
                <li>Email address used during registration.</li>
                <li>Book listings that you create.</li>
                <li>Search queries to improve search results.</li>
                <li>Messages or feedback sent to our support team.</li>
            </ul>

        </section>

        <hr>

        <!-- Usage -->

        <section class="my-5">

            <h3 class="fw-bold">
                <i class="bi bi-gear-fill text-warning me-2"></i>
                How We Use Your Information
            </h3>

            <p class="text-muted mt-3">
                Your information helps us provide a better experience on BooksSeeker.
                Specifically, we use it to:
            </p>

            <ul class="text-muted">

                <li>Create and manage your account.</li>

                <li>Display your book listings.</li>

                <li>Improve website performance and search accuracy.</li>

                <li>Respond to customer support requests.</li>

                <li>Maintain platform security.</li>

            </ul>

        </section>

        <hr>

        <!-- Cookies -->

        <section class="my-5">

            <h3 class="fw-bold">
                <i class="bi bi-cookie text-info me-2"></i>
                Cookies
            </h3>

            <p class="text-muted mt-3">

                BooksSeeker uses cookies to remember your preferences,
                keep you logged in, and improve your browsing experience.
                These cookies do not contain sensitive personal information.

            </p>

        </section>

        <hr>

        <!-- Security -->

        <section class="my-5">

            <h3 class="fw-bold">

                <i class="bi bi-lock-fill text-danger me-2"></i>

                Data Security

            </h3>

            <p class="text-muted mt-3">

                We use reasonable technical and organizational measures to
                protect your personal information from unauthorized access,
                loss, or misuse. While no online platform can guarantee
                absolute security, we continuously work to keep your data safe.

            </p>

        </section>

        <hr>

        <!-- Sharing -->

        <section class="my-5">

            <h3 class="fw-bold">

                <i class="bi bi-share-fill text-primary me-2"></i>

                Information Sharing

            </h3>

            <p class="text-muted mt-3">

                BooksSeeker does not sell your personal information.
                Information may only be shared when required by law
                or to protect the safety and integrity of the platform.

            </p>

        </section>

        <hr>

        <!-- Rights -->

        <section class="my-5">

            <h3 class="fw-bold">

                <i class="bi bi-person-check-fill text-success me-2"></i>

                Your Rights

            </h3>

            <p class="text-muted mt-3">

                As a BooksSeeker user, you have the right to:

            </p>

            <ul class="text-muted">

                <li>Access your account information.</li>

                <li>Update your profile details.</li>

                <li>Edit or remove your listings.</li>

                <li>Request account deletion.</li>

            </ul>

        </section>

        <hr>

        <!-- Updates -->

        <section class="my-5">

            <h3 class="fw-bold">

                <i class="bi bi-arrow-repeat text-secondary me-2"></i>

                Changes to This Policy

            </h3>

            <p class="text-muted mt-3">

                We may update this Privacy Policy from time to time.
                Any changes will be posted on this page along with
                the revised "Last Updated" date.

            </p>

        </section>

        <hr>

        <!-- Contact -->

        <section class="my-5">

            <div class="bg-light rounded-4 border p-5 text-center">

                <i class="bi bi-envelope-paper-fill text-primary" style="font-size:3rem;"></i>

                <h3 class="mt-3 fw-bold">

                    Contact Us

                </h3>

                <p class="text-muted">

                    If you have questions about this Privacy Policy,
                    we'd be happy to help.

                </p>

                <a href="mailto:BooksSeeker@gmail.com" class="btn btn-primary btn-lg">

                    <i class="bi bi-envelope-fill me-2"></i>

                    BooksSeeker@gmail.com

                </a>

            </div>

        </section>

    </div>