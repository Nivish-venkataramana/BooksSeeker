<style>
    #menu-toggle {
        display: none;
    }

    .menu-btn {
        position: fixed;
        top: 18px;
        left: 18px;
        font-size: 28px;
        color: #fe424d;
        cursor: pointer;
        z-index: 2001;
        transition: 0.3s;
        display: block;
    }

    .menu-btn:hover {
        transform: scale(1.1);
    }

    .mobile-sidebar {
        position: fixed;
        top: 0;
        left: -320px;
        width: 300px;
        height: 100vh;
        background: #ffffff;
        box-shadow: 0 0 15px rgba(0, 0, 0, 0.25);
        transition: all .4s ease;
        z-index: 2000;
        overflow-y: auto;
    }


    .sidebar-logo {
        height: 70px;
        display: flex;
        justify-content: left;
        align-items: center;
        border-bottom: 1px solid #ddd;
    }

    .sidebar-logo a {
        text-decoration: none;
        color: #fe424d;
        font-size: 24px;
        font-weight: 700;
    }

    .sidebar-logo i {
        margin-right: 8px;
    }

    .close-btn {
        position: absolute;
        right: 20px;
        top: 20px;
    }

    .close-btn label {
        cursor: pointer;
    }

    .close-btn i {
        font-size: 28px;
        color: #555;
        transition: .3s;
    }

    .close-btn i:hover {
        color: #fe424d;
        transform: rotate(90deg);
    }

    .sidebar-user {
        text-align: center;
        padding: 25px 15px;
        border-bottom: 1px solid #eee;
    }

    .sidebar-user i {
        font-size: 55px;
        color: #fe424d;
        display: block;
        margin-bottom: 10px;
    }

    .sidebar-user span {
        font-size: 18px;
        font-weight: 600;
    }


    .mobile-sidebar ul {
        list-style: none;
        margin: 0;
        padding: 15px 0;
    }

    .mobile-sidebar ul li {
        transition: .3s;
    }

    .mobile-sidebar ul li:hover {
        background: #f7f7f7;
    }

    .mobile-sidebar ul li a {
        display: block;
        padding: 15px 25px;
        text-decoration: none;
        color: #333;
        font-size: 17px;
        transition: .3s;
    }

    .mobile-sidebar ul li a:hover {
        color: #fe424d;
        padding-left: 35px;
    }

    .mobile-sidebar ul li i {
        width: 30px;
        color: #fe424d;
    }

    /* Search */
    .sidebar-search {
        padding: 20px;
        border-top: 1px solid #eee;
    }

    .sidebar-search form {
        display: flex;
    }

    .sidebar-search input {
        width: 100%;
        border: 1px solid #ccc;
        border-radius: 25px 0 0 25px;
        padding: 10px 15px;
        outline: none;
    }

    .sidebar-search button {
        width: 55px;
        border: none;
        background: #fe424d;
        color: white;
        border-radius: 0 25px 25px 0;
        cursor: pointer;
    }


    .sidebar-social {
        text-align: center;
        padding: 30px 0;
    }

    .sidebar-social a {
        display: inline-block;
        margin: 0 8px;
        color: #888;
        font-size: 22px;
        transition: .3s;
    }

    .sidebar-social a:hover {
        color: #fe424d;
        transform: scale(1.2);
    }

    #menu-toggle:checked~.mobile-sidebar {
        left: 0;
    }


    #menu-toggle:checked~.menu-btn {
        opacity: 0;
        pointer-events: none;
    }

    .mobile-overlay {
        display: none;
    }

    #menu-toggle:checked~.mobile-overlay {
        display: block;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, .35);
        z-index: 1500;
    }

    .mobile-sidebar::-webkit-scrollbar {
        width: 6px;
    }

    .mobile-sidebar::-webkit-scrollbar-thumb {
        background: #fe424d;
        border-radius: 10px;
    }

    .sidebar-user {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 18px 20px;
        border-bottom: 1px solid #eee;
        background: #fafafa;
    }
</style>

<input type="checkbox" id="menu-toggle">

<label for="menu-toggle" class="menu-btn">
    <i class="fa-solid fa-bars"></i>
</label>

<div class="mobile-sidebar">

    <!-- Logo -->
    <div class="sidebar-logo">
        <a href="/">
            <i class="fa-solid fa-compass"></i>
            BooksSeeker
        </a>
    </div>

    <div class="close-btn">
        <label for="menu-toggle">
            <i class="fa-solid fa-xmark"></i>
        </label>
    </div>

    <% if(currUser){ %>

        <div class="sidebar-user">

            <div class="user-avatar">
                <i class="fa-solid fa-user"></i>
            </div>

            <div class="user-details">
                <small>Signed in as</small>
                <h6>
                    <%= currUser.username %>
                </h6>
            </div>

        </div>

        <% } %>
            <ul>

                <li>
                    <a href="/">
                        <i class="fa-solid fa-house"></i>
                        Home
                    </a>
                </li>

                <li>
                    <a href="/listings">
                        <i class="fa-solid fa-book"></i>
                        Explore Books
                    </a>
                </li>

                <li>
                    <a href="/listings/new">
                        <i class="fa-solid fa-plus"></i>
                        Add New Listing
                    </a>
                </li>

                <li>
                    <a href="/listings/academic">
                        <i class="fa-solid fa-graduation-cap"></i>
                        Academic
                    </a>
                </li>

                <li>
                    <a href="/listings/fiction">
                        <i class="fa-solid fa-book"></i>
                        Fiction
                    </a>
                </li>

                <li>
                    <a href="/listings/authors">
                        <i class="fa-solid fa-user"></i>
                        Authors
                    </a>
                </li>

                <li>
                    <a href="/listings/children">
                        <i class="fa-solid fa-child"></i>
                        Children
                    </a>
                </li>

                <li>
                    <a href="/listings/science">
                        <i class="fa-solid fa-flask"></i>
                        Science
                    </a>
                </li>

                <li>
                    <a href="/listings/history">
                        <i class="fa-solid fa-landmark"></i>
                        History
                    </a>
                </li>

                <li>
                    <a href="/listings/literature">
                        <i class="fa-solid fa-pen-nib"></i>
                        Literature
                    </a>
                </li>

                <li>
                    <a href="/listings/technology">
                        <i class="fa-solid fa-laptop-code"></i>
                        Technology
                    </a>
                </li>

                <li>
                    <a href="/listings/maths">
                        <i class="fa-solid fa-calculator"></i>
                        Mathematics
                    </a>
                </li>

                <li>
                    <a href="/listings/medical">
                        <i class="fa-solid fa-heart-pulse"></i>
                        Medical
                    </a>
                </li>
                <li>
                    <a href="#">
                        <i class="fa-solid fa-heart"></i>
                        Favorites
                    </a>
                </li>

                <% if(!currUser){ %>

                    <li>
                        <a href="/signup">
                            <i class="fa-solid fa-user-plus"></i>
                            Sign Up
                        </a>
                    </li>

                    <li>
                        <a href="/login">
                            <i class="fa-solid fa-right-to-bracket"></i>
                            Log In
                        </a>
                    </li>

                    <% } %>

                        <% if(currUser){ %>

                            <li>
                                <a href="/logout">
                                    <i class="fa-solid fa-right-from-bracket"></i>
                                    Logout
                                </a>
                            </li>

                            <% } %>

            </ul>


            <div class="sidebar-search">

                <form action="/listings" method="GET">

                    <input type="search" name="search" placeholder="Search books...">

                    <button type="submit">
                        <i class="fa-solid fa-magnifying-glass"></i>
                    </button>

                </form>

            </div>


            <div class="sidebar-social">

                <a href="#"><i class="fa-brands fa-facebook"></i></a>

                <a href="#"><i class="fa-brands fa-twitter"></i></a>

                <a href="#"><i class="fa-brands fa-instagram"></i></a>

                <a href="#"><i class="fa-brands fa-github"></i></a>

            </div>
</div>

<div class="mobile-overlay">
    <label for="menu-toggle" style="display:block;width:100%;height:100%;cursor:pointer;"></label>
</div>